generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShareRole {
  VIEWER
  EDITOR
}

enum GeneralAccess {
  RESTRICTED
  ANYONE
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files     File[]
  shares    Share[]
}

model File {
  id                String        @id @default(cuid())
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id])
  name              String        @default("Untitled")
  currentData       Json
  thumbnailUrl      String?
  generalAccess     GeneralAccess @default(RESTRICTED)
  generalAccessRole ShareRole?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  versions          FileVersion[]
  shares            Share[]

  @@index([ownerId, deletedAt])
}

model FileVersion {
  id           String   @id @default(cuid())
  fileId       String
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  name         String
  data         Json
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@index([fileId, createdAt])
}

model Share {
  id        String    @id @default(cuid())
  fileId    String
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      ShareRole
  createdAt DateTime  @default(now())

  @@unique([fileId, userId])
  @@index([userId])
}
